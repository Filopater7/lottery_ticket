# Supabase Project URL (from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (SERVER ONLY — never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin credentials (set these in Supabase Auth dashboard, not here)
# Create one admin user via Supabase Auth → Users → Add user
# Then set this to that user's email for reference only:
ADMIN_EMAIL=admin@example.com
